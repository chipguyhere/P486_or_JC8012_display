/*******************************************************************************
 * LVGL 9.3 SquareLine Launcher — one 480x480 UI on the JC8012P4A1C or the P486
 *
 * SquareLine Studio exports a UI for one fixed screen size.  This sketch asks
 * for P4Res::Square480 on both boards, so a single 480x480 SquareLine project
 * runs unchanged on either: the ESP32-P4's PPA scales it up in hardware —
 * x1.5 to fill the P486's 720x720 panel, x1.625 to a 780x780 square centred on
 * the JC8012's 800x1280 panel.  Touch is mapped back through the same scale.
 *
 * Want a taller UI on the JC8012?  Use {0, P4Res::Full480} for it (480x768),
 * and lay the SquareLine project out to stretch — the P486 still gets 480x480.
 *
 * Requires the following libraries:
 *   - chipguy_P486_or_JC8012_display  (this library)
 *   - lvgl 9 (9.3 here: SquareLine generates for a specific LVGL version)
 *
 * Arduino IDE Board Settings (the same for both boards):
 *   - Board: ESP32P4 Dev Module
 *   - PSRAM: Enabled   (REQUIRED — the sketch will not compile without it)
 *   - Flash Size: 16MB (128Mb)   (REQUIRED — the JC8012's size; fine on the
 *                                 P486's 32 MB part)
 *   - Partition Scheme: Custom (uses the partitions.csv in this sketch folder)
 *   - USB CDC On Boot: Disabled   (Serial0 — the USB-serial port — is used
 *                                 either way; see LvglClaudeCodeStub)
 *
 ******************************************************************************/

// This is built for LVGL 9.3, which SquareLine can generate UIs for.
#include "lv_conf.h"
#include "lvgl.h"
#include "lv_setup.hpp"

// The folder of UI files generated by SquareLine should be in a subdirectory
// named src in the sketch folder.  The existing files are a small example.
// Simply DELETE all of the example files, and "Export" new "UI files", from
// SquareLine.  Using the "Arduino TFT_eSPI profile" works (among others).
// Required SquareLine project settings: 480x480, 16-bit color depth, no
// rotation or offset (this library handles rotation, so keep the SquareLine
// project unrotated).
#include "src/ui.h"

void setup() {
    Serial0.begin(115200);

    // 480x480 on both boards.  Rotation (0/1/2/3) can differ per board.
    lv_setup.begin({0, P4Res::Square480},  // JC8012: 480x480 -> 780x780
                   {0, P4Res::Square480}); // P486:   480x480 -> 720x720
    Serial0.printf("LVGL initialized on the %s at %dx%d\n",
                   display.boardName(), display.width(), display.height());

    // Start the SquareLine application's own setup
    ui_init();
}

void loop() {
    lv_timer_handler();
    delay(5);
}
